# KAgent Environment Variables
# Copy this file to .env.local and fill in your keys

# Exa API Key (primary LLM — OpenAI-compatible at https://api.exa.ai)
EXA_API_KEY=your_exa_api_key_here

# Band of Agents platform key (optional — for Band platform integration)
BAND_API_KEY=your_band_api_key_here

# Legacy fallback (optional)
OPENAI_API_KEY=your_openai_api_key_here

# App URL (for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
